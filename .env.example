# Public base URL of the API (used as fallback; server components prefer API_URL)
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
# Server-only: preferred API base + key (never exposed to browsers).
# Set API_KEY to the same value as the API's API_KEYS entry.
API_URL=http://localhost:3000/api/v1
API_KEY=
