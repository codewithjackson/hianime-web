# Public base URL of the API — the static frontend calls this directly.
# Set this in Vercel env settings to your backend URL (e.g. your Render URL + /api/v1).
NEXT_PUBLIC_API_URL=http://localhost:3000/api/v1
# Public API key, sent as ?apikey= with every request (backend accepts it there).
# It IS visible in page source — use a dedicated public key, keep admin keys private.
# Must also be listed in the backend's API_KEYS. Abuse is contained per-IP by rate limiting.
NEXT_PUBLIC_API_KEY=
